DATABASE_URL=<sua url de conexao>
LAST_FM_API_KEY=<sua_api_key_aqui>
LAST_FM_SHARED_SECRET=<seu_shared_secret_aqui>
SPOTIFY_CLIENT_ID=<seu_spotify_client_id_aqui>
SPOTIFY_CLIENT_SECRET=<seu_spotify_client_secret_aqui>
# Opcional — só pra OAuth de usuário (reconciliação Spotify ↔ Last.fm).
# Default funciona pro setup local padrão. Tem que bater EXATAMENTE com o Redirect URI
# cadastrado no Spotify Developer Dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:<porta>/api/spotify/oauth/callback
PORT=<porta>
# Senha do "soft gate" — qualquer visitante precisa digitar isso pra
# acessar o app. Cookie HttpOnly de 30 dias. Vazio = acesso livre (sem modal).
SITE_PASSWORD=<defina_uma_senha>

